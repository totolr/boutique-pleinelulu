# Variables d'environnement Pleine Lulu.
# Copier ce fichier en .env et renseigner les valeurs.
# Sur Netlify : Site settings > Environment variables.
#
# Attention : les variables VITE_* sont exposées au navigateur. Les autres
# (sans le préfixe VITE_) restent côté serveur (functions).

# Stripe
# https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX

# Supabase
# https://supabase.com/dashboard > Settings > API
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxx

# Resend (emails de confirmation)
# https://resend.com > API Keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXX
# Tant que tu n'as pas vérifié ton domaine sur Resend, laisse "onboarding@resend.dev"
# (mais Resend n'enverra qu'à l'adresse du compte Resend pendant cette phase).
# Une fois ton domaine vérifié : "Pleine Lulu <commande@pleinelulu.fr>"
RESEND_FROM_EMAIL=Pleine Lulu <onboarding@resend.dev>

# PostHog (analytics)
# https://eu.posthog.com > Project settings
VITE_POSTHOG_KEY=phc_XXXXXXXXXXXXXXXX
VITE_POSTHOG_HOST=https://eu.posthog.com

# URL du site
URL=http://localhost:8888

# Dashboard admin /admin (auth via Supabase)
# Liste des emails autorisés à se connecter au dashboard /admin.
# Séparés par des virgules, sans espace inutile.
# L'auth se fait par "magic link" Supabase : l'utilisateur entre son email,
# reçoit un lien à usage unique, clique, et il est connecté pour 1 heure.
# Étapes côté Supabase Dashboard (à faire UNE FOIS) :
#   1. Authentication > Providers > Email : laisser activé.
#   2. Authentication > Providers > Email > "Allow new users to sign up" : OFF.
#      (sinon n'importe qui pourrait créer un compte)
#   3. Authentication > Users > Add user : créer un compte pour chaque email
#      ci-dessous (option "Auto-confirm user").
#   4. Authentication > URL Configuration > Redirect URLs : ajouter
#      http://localhost:8888/admin  ET  https://ton-domaine.fr/admin
ADMIN_EMAILS=toi@pleinelulu.fr,collegue@pleinelulu.fr
